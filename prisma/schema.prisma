generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Contestants {
  id     Int     @id(map: "candidates_pkey") @default(autoincrement())
  name   String
  image  String
  image2 String?
  Votes  Votes[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model TestTaable {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Votes {
  PurchaseId    String
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  ContestantId  Int
  Votes         BigInt
  Amount        Decimal     @db.Decimal
  PackageType   String
  Status        String?
  TransactionId String?
  LocalId       BigInt?
  Contestants   Contestants @relation(fields: [ContestantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([PurchaseId, created_at, ContestantId, Votes, Amount, PackageType])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id       BigInt  @id @default(autoincrement())
  password String?
}
